  </ItemGroup>
  <Target Name="CompileHtmlHelp" BeforeTargets="Build" Inputs="@(HelpSource)" Outputs="$(MSBuildProjectDirectory)\help\MikasSolitaire.chm">
    <PropertyGroup>
      <HtmlHelpCompiler>$(MSBuildProgramFiles32)\HTML Help Workshop\hhc.exe</HtmlHelpCompiler>
    </PropertyGroup>
    <Error Condition="!Exists('$(HtmlHelpCompiler)')" Text="Install HTML Help Workshop to compile the application help." />
    <Exec Command="&quot;$(HtmlHelpCompiler)&quot; &quot;$(MSBuildProjectDirectory)\help\MikasSolitaire.hhp&quot;" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="HtmlHelpExitCode" />
    </Exec>
    <Error Condition="'$(HtmlHelpExitCode)' != '1' Or !Exists('$(MSBuildProjectDirectory)\help\MikasSolitaire.chm')" Text="HTML Help compilation failed." />
  </Target>
  <Target Name="CompileFinnishHtmlHelp" BeforeTargets="Build" Inputs="@(FinnishHelpSource)" Outputs="$(MSBuildProjectDirectory)\help\fi\MikasSolitaire-fi.chm">
    <PropertyGroup>
      <HtmlHelpCompiler>$(MSBuildProgramFiles32)\HTML Help Workshop\hhc.exe</HtmlHelpCompiler>
    </PropertyGroup>
    <Error Condition="!Exists('$(HtmlHelpCompiler)')" Text="Install HTML Help Workshop to compile the application help." />
    <Exec Command="&quot;$(HtmlHelpCompiler)&quot; &quot;$(MSBuildProjectDirectory)\help\fi\MikasSolitaire.hhp&quot;" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="FinnishHtmlHelpExitCode" />
    </Exec>
    <Error Condition="'$(FinnishHtmlHelpExitCode)' != '1' Or !Exists('$(MSBuildProjectDirectory)\help\fi\MikasSolitaire-fi.chm')" Text="Finnish HTML Help compilation failed." />
  </Target>
  <Target Name="CopyCardImages" AfterTargets="Build">
    <ItemGroup>
      <CardFront Include="res\front\*.png" />
      <CardBack Include="res\back\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(CardFront)" DestinationFiles="@(CardFront->'$(OutDir)res\front\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CardBack)" DestinationFiles="@(CardBack->'$(OutDir)res\back\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\help\MikasSolitaire.chm" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\help\fi\MikasSolitaire-fi.chm" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
